# ── App ──────────────────────────────────────────────────────
APP_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── MySQL (Drizzle operational store) ────────────────────────
MYSQL_PORT=3306
MYSQL_DATABASE=policytwin
MYSQL_USER=policytwin
MYSQL_PASSWORD=policytwin
MYSQL_ROOT_PASSWORD=rootpassword

# ── Python microservices ─────────────────────────────────────
SIMULATION_PORT=8100
AI_PORT=8200
# Default model tier used by the AI router (qwen3-dev | qwen3-32b | qwen3-235b-a22b | deepseek-r1)
MODEL_DEFAULT_TIER=qwen3-dev
VLLM_BASE_URL=http://localhost:8000/v1
RAY_SERVE_URL=http://localhost:8001

# ── MinIO (S3-compatible object storage) ─────────────────────
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=policy-twin

# ── Neo4j (knowledge graph) ──────────────────────────────────
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PASSWORD=policytwin

# ── OpenSearch (search + vectors; security disabled for dev) ─
OPENSEARCH_PORT=9200
OPENSEARCH_ADMIN_PASSWORD=unused-security-disabled

# ── PostGIS (geospatial store) ───────────────────────────────
POSTGIS_PORT=5432
POSTGIS_DB=geo
POSTGIS_USER=policytwin
POSTGIS_PASSWORD=policytwin

# ── Keycloak (OIDC) ──────────────────────────────────────────
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=policy-twin
KEYCLOAK_CLIENT_ID=policy-twin-app

# ── Redpanda (Kafka-compatible event backbone) ───────────────
REDPANDA_PORT=9092
REDPANDA_ADMIN_PORT=9644

# ── Observability ────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
