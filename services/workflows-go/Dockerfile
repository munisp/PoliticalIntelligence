# Go Temporal worker (ADR-010, docs/TEMPORAL.md).
#   docker build -t policy-twin/workflows-go:local services/workflows-go
FROM golang:1.22 AS builder
WORKDIR /src
COPY go.mod ./
# go.sum is generated by `go mod tidy` in CI (toolchain absent in dev sandbox);
# tolerate its absence so this Dockerfile builds either way.
COPY go.su[m] ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/workflows-worker .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/workflows-worker /workflows-worker
USER nonroot
ENTRYPOINT ["/workflows-worker"]
