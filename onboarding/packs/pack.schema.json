{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://meridian.policy.twin/schemas/onboarding-pack.schema.json",
  "title": "Jurisdiction Onboarding Pack",
  "description": "Declarative config pack. Adding a jurisdiction requires a pack file only — no code changes.",
  "type": "object",
  "required": ["pack_version", "jurisdiction", "hierarchy", "connectors", "sectors", "seed_policy"],
  "properties": {
    "pack_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "jurisdiction": {
      "type": "object",
      "required": ["id", "name", "country_iso3", "country_code", "admin_level", "admin_levels", "currency", "languages"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]{2}-[a-z0-9-]+$", "description": "e.g. ng-kd" },
        "name": { "type": "string" },
        "country_iso3": { "type": "string", "minLength": 3, "maxLength": 3 },
        "country_code": { "type": "string", "minLength": 2, "maxLength": 2 },
        "admin_level": { "enum": ["federal", "state", "lga", "ward"] },
        "admin_levels": {
          "type": "array",
          "items": { "enum": ["federal", "state", "lga", "ward"] },
          "minItems": 1
        },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "languages": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "parent_id": { "type": "string", "description": "parent jurisdiction id, e.g. nga" }
      }
    },
    "hierarchy": {
      "type": "object",
      "required": ["level", "units"],
      "properties": {
        "level": { "enum": ["state", "lga", "ward"], "description": "admin level of the listed units" },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "population": { "type": ["integer", "null"] },
              "children": { "type": "array", "items": { "$ref": "#/properties/hierarchy/properties/units/items" } }
            }
          }
        }
      }
    },
    "connectors": {
      "type": "object",
      "properties": {
        "worldbank": {
          "type": "object",
          "required": ["country_iso3", "indicators"],
          "properties": {
            "country_iso3": { "type": "string" },
            "indicators": { "type": "array", "items": { "type": "string" } },
            "since": { "type": "string" }
          }
        },
        "overpass": {
          "type": "object",
          "required": ["area_name"],
          "properties": {
            "area_name": { "type": "string", "description": "OSM admin area name" },
            "admin_level": { "type": "integer" },
            "amenities": { "type": "array", "items": { "enum": ["school", "clinic", "hospital", "marketplace"] } }
          }
        },
        "hdx": {
          "type": "object",
          "properties": {
            "queries": { "type": "array", "items": { "type": "string" } },
            "download_csv": { "type": "boolean" }
          }
        },
        "nada": {
          "type": "object",
          "properties": { "search": { "type": "string" }, "page_size": { "type": "integer" } }
        },
        "budeshi": {
          "type": "object",
          "properties": {
            "buyer_names": { "type": "array", "items": { "type": "string" } },
            "limit": { "type": "integer" }
          }
        },
        "file_harvester": {
          "type": "object",
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["url"],
                "properties": { "url": { "type": "string" }, "kind": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "sectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name", "multiplier_set"],
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "multiplier_set": { "type": "string", "description": "reference to simulation multiplier set" }
        }
      }
    },
    "seed_policy": {
      "type": "object",
      "required": ["allowed"],
      "properties": {
        "allowed": {
          "type": "array",
          "description": "entity kinds that may fall back to clearly-labeled `seed` demo data when no live source exists",
          "items": { "enum": ["sector_metrics", "opportunities", "evidence_sources", "facilities", "procurement_records"] }
        },
        "notes": { "type": "string" }
      }
    },
    "targets": {
      "type": "object",
      "properties": {
        "jobs_target": { "type": "integer" },
        "horizon_months": { "type": "integer" }
      }
    },
    "branding": {
      "type": "object",
      "properties": {
        "display_name": { "type": "string" },
        "tagline": { "type": "string" }
      }
    }
  }
}
