# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── feat-llm-events: LLM serving / eventing / security ─────────
# vLLM per-tier endpoints (fallback: VLLM_BASE_URL). Empty -> offline synthesizer.
VLLM_BASE_URL=              # default tier endpoint (e.g. http://vllm:8000)
VLLM_BASE_URL_DEFAULT=      # interactive/default tier (Qwen3-32B)
VLLM_BASE_URL_PREMIUM=      # premium tier (Qwen3-235B-A22B)
VLLM_BASE_URL_SPECIALIST=   # specialist tier (DeepSeek-R1)
VLLM_API_KEY=               # optional bearer for the serving endpoint
VLLM_MODEL=Qwen/Qwen3-32B   # compose gpu-profile model
HF_TOKEN=                   # Hugging Face token for gated models
LLM_TIMEOUT_SECONDS=30
LLM_HEDGE_AFTER_MS=0        # >0 enables request hedging (p95 duplicate fire)
LLM_BREAKER_FAILURES=3      # circuit breaker failure threshold per tier
LLM_BREAKER_RESET_SECONDS=30

# Event consumers (default on). Kafka mode when KAFKA_BROKERS is set,
# otherwise the durable outbox consumer loop with the same retry/DLQ semantics.
EVENT_CONSUMERS=1
KAFKA_BROKERS=              # e.g. redpanda:9092

# PII redaction (default on; counts-only logging, PII never logged)
PII_REDACTION=on
PII_EXTRA_PATTERNS=         # JSON array of {name, pattern, flags}

# WORM audit export
WORM_EXPORT_DIR=./artifacts/audit-worm
WORM_EXPORT_INTERVAL_MS=3600000
WORM_S3_BUCKET=             # optional S3 Object-Lock bucket (COMPLIANCE mode)
WORM_S3_PREFIX=audit-worm/
WORM_S3_PRESIGN_URL_TEMPLATE=  # optional presigned-PUT template with {key}
WORM_RETENTION_YEARS=7

# Sovereign IdP (Keycloak) alternative auth provider. Default: kimi.
AUTH_PROVIDER=kimi          # kimi | keycloak
OIDC_ISSUER=                # e.g. http://localhost:8080/realms/policy-twin
OIDC_CLIENT_ID=policy-twin-web
OIDC_CLIENT_SECRET=
